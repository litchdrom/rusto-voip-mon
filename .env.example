# --- HTTP server ---
LISTEN=0.0.0.0:8080

# --- VoIPmonitor MySQL/MariaDB (read-only recommended) ---
DATABASE_URL=mysql://voipmonitor:CHANGE_ME@127.0.0.1:3306/voipmonitor

# --- VoIPmonitor pcap spool directory (mount as :ro in Docker) ---
PCAP_DIR=/var/spool/voipmonitor

# --- Auth ---
# Generate with: openssl rand -hex 32
APP_COOKIE_SECRET=CHANGE_ME_TO_RANDOM_64_HEX_CHARS

# --- CSV export cap (rows per export) ---
# Default 10000. Per-request override: ?csv_limit=N
CSV_EXPORT_LIMIT=10000

# --- Display/filter timezone offset from UTC, in SECONDS ---
# Used for the default "today" filter window, the "Today"/"Yesterday"
# label, and the per-operator fallback in the topbar TZ selector.
# Seconds (not hours) so non-whole-hour zones work too:
#   * 28800  = UTC+8   (Beijing / Singapore / Perth)
#   * 19800  = UTC+5:30 (India / Sri Lanka / IST)
#   * 20700  = UTC+5:45 (Nepal)
#   * 45900  = UTC+12:45 (Chatham Islands)
# Operators can override per-session from the topbar; this is just the
# pre-login default. Range -43200..=50400. Set to 0 to disable
# (server clock is UTC).
APP_TZ_OFFSET_SECS=0

# --- Stored-calldate timezone offset, in HOURS (NOT seconds) ---
# ONLY set this when your VoIPmonitor MySQL session stores calldate as
# server-local DATETIME rather than UTC. The default VoIPmonitor
# convention is UTC, so leave this at 0 unless you see CDR times
# displayed with a constant offset of N hours from the actual wall
# clock time of the call. Examples: 8 if calldate is stored in UTC+8
# wall-clock time; -5 for US Eastern. Internally converted to seconds.
APP_DB_TZ_OFFSET_HOURS=0

# --- Per-query timeout in seconds ---
# Bounds how long any single sqlx call (CDR list setup, detail page,
# distinct-values, pcap parts lookup) is allowed to run. A timeout returns
# HTTP 504 to the client and releases the pool slot immediately. The
# underlying MySQL query may still run server-side for a while. Set to 0
# to disable.
APP_QUERY_TIMEOUT_SECS=30

# --- Logging ---
RUST_LOG=info,rusto_voip_mon=debug,tower_http=info,sqlx=warn
