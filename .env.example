# --- HTTP server ---
LISTEN=0.0.0.0:8080

# --- VoIPmonitor MySQL/MariaDB (read-only recommended) ---
DATABASE_URL=mysql://voipmonitor:CHANGE_ME@127.0.0.1:3306/voipmonitor

# --- VoIPmonitor pcap spool directory (mount as :ro in Docker) ---
PCAP_DIR=/var/spool/voipmonitor

# --- Auth ---
# Generate with: openssl rand -hex 32
APP_COOKIE_SECRET=CHANGE_ME_TO_RANDOM_64_HEX_CHARS

# --- Logging ---
RUST_LOG=info,rusto_voip_mon=debug,tower_http=info,sqlx=warn
